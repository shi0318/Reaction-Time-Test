---
import { SITE, SISTER_SITES, SOURCES } from '../data/site';
import { LANGUAGE_ENTRIES, getHomeContent, type Locale } from '../data/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const content = getHomeContent(locale);
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <section>
      <a class="brand footer-brand" href={content.path}>
        <img src="/logo.svg" width="36" height="36" alt="" />
        <span>Reaction Time Test</span>
      </a>
      <p class="footer-note">{content.footer.note}</p>
    </section>
    <section>
      <h2>{content.footer.play}</h2>
      <ul>
        <li><a href={`${content.path}#play`}>{content.nav.play}</a></li>
        <li><a href={`${content.path}#how-it-works`}>{content.nav.method}</a></li>
        <li><a href={`${content.path}#faq`}>{content.nav.faq}</a></li>
      </ul>
    </section>
    <section>
      <h2>{content.footer.learn}</h2>
      <ul>
        <li><a href={locale === 'en' ? '/reaction-tests/' : `/${locale}/reaction-tests/`}>{locale === 'zh' ? '全部反应测试' : locale === 'ko' ? '모든 반응 테스트' : locale === 'hi' ? 'सभी प्रतिक्रिया परीक्षण' : locale === 'fr' ? 'Tous les tests de réaction' : 'All reaction tests'}</a></li>
        <li><a href={locale === 'en' ? '/choice-reaction-time-test/' : `/${locale}/choice-reaction-time-test/`}>{locale === 'zh' ? '选择反应时间测试' : locale === 'ko' ? '선택 반응 시간 테스트' : locale === 'hi' ? 'चयन प्रतिक्रिया समय परीक्षण' : locale === 'fr' ? 'Test de choix' : 'Choice reaction time test'}</a></li>
        <li><a href={locale === 'en' ? '/color-reaction-test/' : `/${locale}/color-reaction-test/`}>{locale === 'zh' ? '颜色反应测试' : locale === 'ko' ? '색상 반응 테스트' : locale === 'hi' ? 'रंग प्रतिक्रिया परीक्षण' : locale === 'fr' ? 'Test de couleur' : 'Color reaction test'}</a></li>
        <li><a href="/average-reaction-time/">Average reaction time</a></li>
        <li><a href="/reaction-time-test/">Five-round method</a></li>
        <li><a href="/reaction-time-by-age/">Reaction time by age</a></li>
        <li><a href="/f1-driver-reaction-time/">F1 driver reaction time</a></li>
        <li><a href={SOURCES[0].url} target="_blank" rel="nofollow noopener noreferrer">Timing reference</a></li>
      </ul>
    </section>
    <section>
      <h2>{content.footer.site}</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/sitemap/">HTML sitemap</a></li>
        <li><a href="/sitemap-index.xml">XML sitemap</a></li>
      </ul>
    </section>
    <section>
      <h2>Other sites</h2>
      <ul>
        {SISTER_SITES.map((site) => <li><a href={site.href} rel="noopener">{site.name}</a></li>)}
      </ul>
    </section>
    <section>
      <h2>{content.footer.languages}</h2>
      <ul class="footer-language-list">
        {LANGUAGE_ENTRIES.map((entry) => (
          <li><a href={entry.path} hreflang={entry.htmlLang} lang={entry.htmlLang} aria-current={entry.locale === locale ? 'page' : undefined}>{entry.languageName}</a></li>
        ))}
      </ul>
    </section>
  </div>
  <div class="shell footer-bottom">© {new Date().getFullYear()} {SITE.name}. Independent browser tool.</div>
</footer>
