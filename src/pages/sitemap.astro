---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  ['Reaction Time Test', '/', 'Run the five-round visual reaction test.'],
  ['Five-round method', '/reaction-time-test/', 'Read the false-start rule and score summary.'],
  ['Average Reaction Time', '/average-reaction-time/', 'Read typical browser ranges and how to interpret a session average.'],
  ['Reaction Time by Age', '/reaction-time-by-age/', 'See why age-group charts are not a diagnosis.'],
  ['F1 Driver Reaction Time', '/f1-driver-reaction-time/', 'Compare race-start examples with a browser visual test.'],
  ['How It Works', '/how-it-works/', 'Review the timer and session method.'],
  ['About', '/about/', 'Learn about the independent tool.'],
  ['Contact', '/contact/', 'Send site feedback.'],
  ['Privacy Policy', '/privacy-policy/', 'Read the site privacy policy.'],
];
---

<BaseLayout title="HTML Sitemap | Reaction Time Test" description="HTML sitemap for Reaction Time Test, including the interactive tool, score guide, method notes, and site information.">
  <section class="article-hero"><div class="shell"><p class="eyebrow">Site navigation</p><h1>HTML Sitemap</h1><p class="lede">A plain list of the pages available on Reaction Time Test.</p></div></section>
  <article class="article-page article-copy">
    <ul>
      {links.map(([label, href, description]) => <li><a href={href}>{label}</a> - {description}</li>)}
      <li><a href="/sitemap-index.xml">XML sitemap</a> - Machine-readable sitemap for search engines.</li>
    </ul>
  </article>
</BaseLayout>
