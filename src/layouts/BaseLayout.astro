---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AmbientParticles from '../components/AmbientParticles.astro';
import { SITE } from '../data/site';
import { LANGUAGE_ENTRIES, getHomeContent, type Locale } from '../data/locales';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  faqs?: Faq[];
  pageType?: 'home' | 'article';
  locale?: Locale;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  faqs = [],
  pageType = 'article',
  locale = 'en',
} = Astro.props;
const canonical = new URL(canonicalPath, SITE.url).href;
const localeContent = getHomeContent(locale);
const ogLocale = {
  en: 'en_US',
  zh: 'zh_CN',
  ko: 'ko_KR',
  hi: 'hi_IN',
  fr: 'fr_FR',
}[locale];

const organization = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: {
    '@type': 'ImageObject',
    '@id': `${SITE.url}/#logo`,
    url: `${SITE.url}/logo.svg`,
    width: 128,
    height: 128,
  },
  email: SITE.email,
};

const graph: Record<string, unknown>[] = [organization];

if (pageType === 'home') {
  graph.push(
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      name: SITE.name,
      url: canonical,
      inLanguage: localeContent.htmlLang,
      description,
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'WebApplication',
      '@id': `${canonical}#app`,
      name: title,
      url: canonical,
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web',
      browserRequirements: 'Requires a modern browser with JavaScript enabled for the interactive test.',
      isAccessibleForFree: true,
      description,
      featureList: ['Five reaction rounds', 'Optional unlimited practice mode', 'Best, median, and average session scores', 'Mouse, touch, and keyboard support'],
      publisher: { '@id': `${SITE.url}/#organization` },
    },
  );
} else {
  graph.push({
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: title,
    description,
    url: canonical,
    inLanguage: 'en-US',
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
  });
}

if (faqs.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={localeContent.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {pageType === 'home' && LANGUAGE_ENTRIES.map((entry) => (
      <link rel="alternate" hreflang={entry.htmlLang} href={new URL(entry.path, SITE.url).href} />
    ))}
    {pageType === 'home' && <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />}
    <meta property="og:type" content={pageType === 'home' ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/logo.svg`} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#111827" />
    <meta name="application-name" content={SITE.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <AmbientParticles />
    <a class="skip-link" href="#main">Skip to the main content</a>
    <Header locale={locale} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
